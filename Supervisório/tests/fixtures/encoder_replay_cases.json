{
  "schema_version": 1,
  "description": "Casos compactos para paridade futura do nucleo causal do encoder.",
  "cases": {
    "wrap_forward": {
      "radius_mm": 10.0,
      "max_target_speed_mm_s": 100.0,
      "samples": [[0.000, 358.0], [0.005, 359.0], [0.010, 0.0], [0.015, 1.0]],
      "expected_unwrapped_deg": [358.0, 359.0, 360.0, 361.0]
